// Public defaults support the local Preview build. Use your own identifiers for iCloud.
LIFEOS_TEAM_ID =
LIFEOS_BUNDLE_ID = com.example.LifeOS
LIFEOS_CLOUD_CONTAINER = iCloud.$(LIFEOS_BUNDLE_ID)
LIFEOS_APP_GROUP = group.$(LIFEOS_BUNDLE_ID)
LIFEOS_URL_SCHEME = lifeos
LIFEOS_CLOUD_ENVIRONMENT = Development
LIFEOS_PUSH_ENVIRONMENT = development
LIFEOS_VERSION = 1.0.0
LIFEOS_BUILD = 16

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(LIFEOS_TEAM_ID)
